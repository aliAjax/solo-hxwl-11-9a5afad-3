{
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5111",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5111",
    "typecheck": "tsc --noEmit",
